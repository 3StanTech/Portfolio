---
// Stylesheet order: the Glasswork material, its dark tiers, the element base rules
// (global.css imports tokens.css), then the G4 system and the motion set.
import '../vendor/glasswork/glass.css';
import '../styles/material.css';
import '../styles/global.css';
import '../styles/g4.css';
import '../styles/fx.css';
import Sprite from '../components/Sprite.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { contact } from '../data/contact';
// Preload the two faces the first screen paints (headline and accent word), so the
// headline does not re-wrap when they land (layout shift).
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import accentUrl from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-italic.woff2?url';

const {
  title = 'Tristan Dolfo | Full-Stack Developer from the Philippines',
  description = 'Fast, polished sites and systems for businesses. Built by Tristan Dolfo. Philippines.',
  canonical = Astro.url.pathname,
  // Query version forces social crawlers to re-fetch after brand/copy changes.
  ogImage = '/og-image.png?v=20261109-1',
  // Missing-page style surfaces: robots noindex and no canonical.
  noindex = false,
  jsonLd
} = Astro.props;

// astro.config.mjs guarantees `site` is set, so Astro.site is always defined
// here. Guard anyway rather than fall back to a wrong hardcoded URL.
const siteUrl = Astro.site;
if (!siteUrl) {
  throw new Error('Astro.site is undefined: set SITE_URL before building.');
}
const canonicalUrl = new URL(canonical, siteUrl).toString();
const ogUrl = new URL(ogImage, siteUrl).toString();
const ogImageAlt = 'Tristan Dolfo, full-stack developer in the Philippines. Sites and systems for businesses worldwide.';
const { resumeHref } = contact;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={accentUrl} as="font" type="font/woff2" crossorigin />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tristan Dolfo" />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Mark JS as available before first paint (scroll reveal and the headline motion
      // run only under html.js, so no-JS visitors get everything visible), and mark
      // Save-Data so every effect stays off for metered visitors.
      document.documentElement.classList.add('js');
      if (navigator.connection && navigator.connection.saveData) document.documentElement.classList.add('save-data');
    </script>
    <script is:inline>
      // The page transition's cover (warp.js): the first page of a visit, and a page reached by
      // the short warp, start black before first paint so the arrival can emerge over them.
      // Never under reduced motion or Save-Data; storage may throw (private modes), so guarded.
      (function () {
        try {
          var d = document.documentElement, s = sessionStorage, c = navigator.connection;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || (c && c.saveData)) return;
          var a = s.getItem('bh-arrive');
          if (a || !s.getItem('bh-visited')) { d.classList.add('bh-cover'); d.setAttribute('data-bh-arrive', a ? 'warp' : 'full'); }
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-email={contact.email}>
    <Sprite />
    <a class="skip" href="#main">Skip to content</a>
    <canvas class="sky" aria-hidden="true"></canvas>
    <div class="edge-top" aria-hidden="true"></div>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <script is:inline>
      // Folding panels (Home process rail, Services tiers). On mouse and pen devices each panel's
      // open height is reserved, so folding never moves what is below it; on devices without
      // hover (opened by a tap on "+", folded by a second tap) nothing is reserved and the page
      // grows when a panel opens. Runs here, before the first paint, so a panel never folds after
      // the page is drawn (layout shift); site.js reruns it on fonts, load, width changes and
      // when hover support changes. Measured once open (html.rv-probe forces the open layout for
      // one synchronous read; hover devices only) and once folded (html.rv-ready turns folding
      // on): on hover devices the difference is the folded panel's bottom margin, and each group
      // keeps its open height. --tier-fold holds
      // the tallest folded tier, so the side-by-side Services tiers fold to one shared height.
      // html.rv-still holds the fold transitions off meanwhile. Without this script the panels
      // stay open.
      window.rvReserve = function () {
        var root = document.documentElement, panels = Array.prototype.slice.call(document.querySelectorAll('.rv'));
        if (!panels.length) return;
        var touch = matchMedia('(hover: none)').matches;
        var groups = [];
        panels.forEach(function (el) { var g = el.parentElement.closest('.bento, .svc-tiers') || el.parentElement; if (groups.indexOf(g) < 0) groups.push(g); });
        root.classList.add('rv-still');
        groups.forEach(function (g) { g.style.minHeight = ''; g.style.removeProperty('--tier-fold'); });
        panels.forEach(function (el) { el.style.removeProperty('--rv-gap'); });
        // The open layout is read only where it is reserved (not on touch).
        var open = [], hold = [];
        if (!touch) {
          root.classList.add('rv-probe');
          open = panels.map(function (el) { return el.getBoundingClientRect().height; }); hold = groups.map(function (g) { return g.getBoundingClientRect().height; });
          root.classList.remove('rv-probe');
        }
        root.classList.add('rv-ready');
        // Every panel is measured folded, an open one included (is-open is lifted for this one
        // synchronous read), so a panel open during a rerun still gets its gap for when it folds.
        var wasOpen = panels.map(function (el) { var o = el.classList.contains('is-open'); el.classList.remove('is-open'); return o; });
        var folded = panels.map(function (el) { return el.getBoundingClientRect().height; });
        if (!touch) panels.forEach(function (el, i) { el.style.setProperty('--rv-gap', Math.max(0, open[i] - folded[i]) + 'px'); });
        groups.forEach(function (g) {
          if (!g.matches('.svc-tiers')) return;
          var max = 0;
          panels.forEach(function (el, i) { if (el.parentElement === g) max = Math.max(max, folded[i]); });
          g.style.setProperty('--tier-fold', max + 'px');
        });
        panels.forEach(function (el, i) { if (wasOpen[i]) el.classList.add('is-open'); });
        if (!touch) groups.forEach(function (g, i) { g.style.minHeight = hold[i] + 'px'; });
        panels[0].getBoundingClientRect();
        requestAnimationFrame(function () { root.classList.remove('rv-still'); });
      };
      window.rvReserve();
    </script>
    <footer class="container foot">
      <div>
        <strong>Personally crafted creations, just like this site.</strong>
        <div class="pills">
          <a class="glass" data-kind="dark" data-tier="clear" data-pill href={resumeHref} target="_blank" rel="noopener" aria-label="View Résumé (PDF, opens in new tab)">View Résumé</a>
          <a class="social glass" data-kind="dark" data-tier="clear" data-pill href={contact.github} target="_blank" rel="noopener" aria-label="Tristan Dolfo on GitHub (opens in new tab)"><svg aria-hidden="true"><use href="#i-gh" /></svg></a>
          <a class="social glass" data-kind="dark" data-tier="clear" data-pill href={contact.facebook} target="_blank" rel="noopener" aria-label="Tristan Dolfo on Facebook (opens in new tab)"><svg aria-hidden="true"><use href="#i-fb" /></svg></a>
        </div>
      </div>
    </footer>
    <p class="visually-hidden" aria-live="polite" data-copy-status></p>
    <script>
      import { contact } from '../data/contact';
      import '../scripts/site.js';
      import '../scripts/fx.js';

      // A lil hello for the curious recruiters and devs who open the console.
      console.log(
        `%cTristan · full-stack developer%c\nLiked the build? Let’s make yours. → ${contact.email}`,
        'font: 650 15px/1.5 Georgia, serif; color: #D9822B',
        'font: 400 13px/1.6 system-ui, sans-serif; color: #9DBBE6'
      );
    </script>
  </body>
</html>
