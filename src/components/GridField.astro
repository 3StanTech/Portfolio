---
// Ripple pointer effect over the drafting grid of each .gf-section (Projects and
// the light bands on Home and About).
// The grid itself is CSS (global.css); this script only redraws the lattice near
// the pointer, bent by waves running outward, inside a soft hole in the CSS grid.
---
<script>
  // Hard rules, shared with the constellation: no canvas work under reduced
  // motion or Save-Data (the static CSS grid stays), a live switch when reduced
  // motion changes, paused offscreen, devicePixelRatio capped at 2, the palette
  // re-read every frame so a theme flip recolors it, and mouse/pen only (touch
  // gets the static grid).
  const root = document.documentElement;
  const sections = document.querySelectorAll<HTMLElement>('.gf-section');
  const motionQuery = matchMedia('(prefers-reduced-motion: reduce)');
  const fineQuery = matchMedia('(pointer: fine)');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  // Isometric lattice: 56px triangles (matches the CSS mask tile, 56 x 97).
  const DX = 56;
  const DY = 48.5;
  const SLOPE = 28 / 48.5;
  const REACH = 220;

  type RGB = [number, number, number];
  // Colours come only from the tokens; if one cannot be read, the effect skips
  // the frame (the static CSS grid stays), as the constellation does.
  const parse = (value: string): RGB | null => {
    const v = value.trim();
    const hex = v.match(/^#([\da-f]{6})$/i);
    if (hex) return [0, 2, 4].map((i) => parseInt(hex[1].slice(i, i + 2), 16)) as RGB;
    const rgb = v.match(/^rgba?\(([^)]+)\)$/i);
    const values = rgb ? rgb[1].split(/[,\s/]+/).slice(0, 3).map(Number) : [];
    return values.length === 3 && values.every(Number.isFinite) ? (values as RGB) : null;
  };
  const readPalette = () => {
    const styles = getComputedStyle(root);
    const dark = root.dataset.theme === 'dark';
    const steel = parse(styles.getPropertyValue('--steel'));
    const warm = parse(styles.getPropertyValue(dark ? '--amber' : '--amber-dark'));
    return steel && warm ? { steel, warm } : null;
  };
  const mix = (a: RGB, b: RGB, t: number): RGB => a.map((v, i) => Math.round(v + (b[i] - v) * t)) as RGB;
  const rgba = (c: RGB, a: number) => `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${Math.max(0, Math.min(1, a))})`;

  sections.forEach((section) => {
    const wrap = document.createElement('div');
    wrap.className = 'gf-fx';
    wrap.setAttribute('aria-hidden', 'true');
    const canvas = document.createElement('canvas');
    wrap.append(canvas);
    section.prepend(wrap);
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let frame = 0;
    let visible = true;
    let intensity = 0;
    const pointer = { cx: 0, cy: 0, active: false };
    const enabled = () => !motionQuery.matches && !saveData && fineQuery.matches;
    const request = () => { if (!frame) frame = requestAnimationFrame(draw); };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      request();
    };

    function draw(time: number) {
      frame = 0;
      ctx!.clearRect(0, 0, width, height);
      if (!enabled() || !visible || !width) { section.classList.remove('is-warping'); return; }
      const sr = section.getBoundingClientRect();
      const cr = canvas.getBoundingClientRect();
      const offX = cr.left - sr.left;
      const offY = cr.top - sr.top;
      const px = pointer.cx - sr.left;
      const py = pointer.cy - sr.top;
      intensity += ((pointer.active ? 1 : 0) - intensity) * 0.2;
      const a = intensity;
      let keepGoing = Math.abs((pointer.active ? 1 : 0) - intensity) > 0.01;

      // The CSS grid gets a soft hole at the pointer (.is-warping mask) and the
      // canvas redraws the lattice inside it, displaced by outward waves that fall
      // to ~0 by 70% of the reach, where the canvas lines crossfade into the CSS
      // grid, so the seam does not show.
      const pal = readPalette();
      const warping = a > 0.01 && pal !== null;
      section.classList.toggle('is-warping', warping);
      if (warping && pal) {
        const c = ctx!;
        section.style.setProperty('--gx', `${px}px`);
        section.style.setProperty('--gy', `${py}px`);
        section.style.setProperty('--gr', `${REACH}px`);
        const now = time || performance.now();
        const bend = (x: number, y: number) => {
          const dx = x - px;
          const dy = y - py;
          const d = Math.hypot(dx, dy);
          if (!d || d >= REACH) return [x, y];
          const u = 1 - d / REACH;
          const shift = Math.sin(d / 16 - now * 0.0045) * 6 * u * u * a;
          return [x + (dx / d) * shift, y + (dy / d) * shift];
        };
        // Match the faded CSS grid's strength (--gf-ink at half opacity).
        const ink = (root.dataset.theme === 'dark' ? 0.36 : 0.3) * 0.5;
        const base = ink * 0.6;
        const grad = c.createRadialGradient(px, py, 0, px, py, REACH);
        grad.addColorStop(0, rgba(pal.warm, Math.max(base, 0.9 * a)));
        grad.addColorStop(0.32, rgba(mix(pal.steel, pal.warm, 0.55), Math.max(base, 0.5 * a)));
        grad.addColorStop(0.7, rgba(pal.steel, base));
        grad.addColorStop(1, rgba(pal.steel, 0));
        const path = (x0: number, y0: number, x1: number, y1: number) => {
          const steps = Math.max(2, Math.ceil(Math.hypot(x1 - x0, y1 - y0) / 6));
          for (let s = 0; s <= steps; s += 1) {
            const t = s / steps;
            const [x, y] = bend(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t);
            if (s) c.lineTo(x, y); else c.moveTo(x, y);
          }
        };
        c.save();
        c.translate(-offX, -offY);
        c.beginPath();
        c.arc(px, py, REACH, 0, Math.PI * 2);
        c.clip();
        c.lineWidth = 1;
        const top = py - REACH;
        const bottom = py + REACH;
        c.beginPath();
        for (let y = Math.floor(top / DY) * DY; y <= bottom; y += DY) path(px - REACH, y + 0.5, px + REACH, y + 0.5);
        for (const slope of [SLOPE, -SLOPE]) {
          const k0 = Math.floor((px - REACH - Math.max(top * slope, bottom * slope)) / DX);
          const k1 = Math.ceil((px + REACH - Math.min(top * slope, bottom * slope)) / DX);
          for (let k = k0; k <= k1; k += 1) path(k * DX + top * slope, top, k * DX + bottom * slope, bottom);
        }
        c.strokeStyle = grad;
        c.stroke();
        c.restore();
        if (pointer.active) keepGoing = true;
      }
      if (keepGoing) request();
    }

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; request(); }).observe(section);
    section.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      pointer.cx = event.clientX;
      pointer.cy = event.clientY;
      pointer.active = true;
      request();
    }, { passive: true });
    section.addEventListener('pointerleave', () => { pointer.active = false; request(); });
    window.addEventListener('scroll', request, { passive: true });
    motionQuery.addEventListener('change', request);
    new MutationObserver(request).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    resize();
  });
</script>
