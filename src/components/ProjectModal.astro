---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;
const liveLabel = d.liveLabel ?? 'Visit the site';
const caseStudyHref = `/projects/${d.slug}/`;
---
<dialog class="pm" id={`pm-${d.slug}`} aria-labelledby={`pm-title-${d.slug}`}>
  <div class="pm-inner">
    <button class="pm-close btn glass" data-kind="dark" data-tier="clear" data-pill type="button" data-modal-close aria-label="Close">
      <svg aria-hidden="true"><use href="#i-close" /></svg>
    </button>
    <div class="pm-media">
      <Image src={d.cover} alt={d.coverAlt ?? `${d.title} home page`} widths={[520, 900]} sizes="(max-width: 700px) 92vw, 640px" />
    </div>
    <div class="pm-body" tabindex="0" role="region" aria-label={`${d.title} details`}>
      <p class="pm-meta">
        <span>{d.kind === 'commercial' ? 'Commercial' : 'Personal'}</span>
        <span>{d.year}</span>
        <span>{d.clientType}</span>
      </p>
      <h2 id={`pm-title-${d.slug}`}>{d.title}</h2>
      {d.blurb && <p class="pm-blurb">{d.blurb}</p>}
      <p>{d.summary}</p>
      {d.outcome && (
        <div class="pm-outcome">
          <span class="mono">Outcome</span>
          <strong>{d.outcome}</strong>
        </div>
      )}
      <div class="stack" role="list" aria-label="Stack">
        {d.stack.map((item: string) => <span class="pill" role="listitem">{item}</span>)}
      </div>
    </div>
    <div class="pm-actions">
      {d.liveUrl ? (
        <>
          <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href={d.liveUrl} target="_blank" rel="noopener" aria-label={`${liveLabel}: ${d.title} (opens in new tab)`}>{liveLabel}<svg class="icon" aria-hidden="true"><use href="#i-ext" /></svg></a>
          {d.caseStudy && <a class="link-go" href={caseStudyHref}>Read the case study<svg aria-hidden="true"><use href="#i-arrow" /></svg></a>}
          {d.demoNote && <p class="pm-demo-note">{d.demoNote}</p>}
        </>
      ) : d.caseStudy ? (
        <>
          <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href={caseStudyHref}>Read the case study<svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg></a>
          {d.repoUrl && (
            <a class="link-go" href={d.repoUrl} target="_blank" rel="noopener" aria-label={`View the code: ${d.title} on GitHub (opens in new tab)`}>View the code<svg aria-hidden="true"><use href="#i-ext" /></svg></a>
          )}
        </>
      ) : (
        <p class="pm-note">This one runs behind a PIN-gated login, so there is no public URL to visit.</p>
      )}
    </div>
  </div>
</dialog>
