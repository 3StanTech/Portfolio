---
const steps = [
  {
    title: 'Scope',
    text: 'First, I learn what your business needs to succeed: your offer, your audience, your goals. This gives the build direction from day one.'
  },
  {
    title: 'Build',
    text: 'I turn the scope into a secure, responsive site with SEO essentials, structured data, and direct contact routes.'
  },
  {
    title: 'Launch',
    text: 'A focused first version is launched, then I refine the site appropriately based on how real visitors actually use it.'
  }
];
---
<ol class="process-list panel">
  {steps.map((step) => (
    <li data-reveal>
      <div>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </div>
    </li>
  ))}
</ol>
