---
// Projects Inspector, Spotlight layout (glass overhaul): a typographic index of every
// build on the left, the selected build's capture as a big stage on the right, and its
// details on a glass sheet over the capture. Every build is rendered here; projects.js
// shows one at a time. Without JavaScript the index hides and all builds show stacked,
// complete (overview included). Styles live in g4.css.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>;
type Group = Project['data']['group'];

interface Props {
  groups: { group: Group; title: string; projects: Project[] }[];
}

const { groups } = Astro.props;
// Short tag per group, shown first in each sheet's tag row.
const tags: Record<Group, string> = { systems: 'App', websites: 'Website', small: 'Personal' };
const ordered = groups.flatMap((g) => g.projects.map((project) => ({ project, group: g.group })));
let number = 0;
---
<div class="ins" data-ins>
  <div class="ins-side">
    <ul class="ins-list">
      <li class="pick-lens" aria-hidden="true"></li>
      {groups.map(({ title, projects }) => (
        <>
          <li class="ins-label" aria-hidden="true">{title}</li>
          {projects.map((project) => {
            const i = number++;
            return (
              <li>
                <button class="ins-pick" type="button" data-i={i} aria-controls="ins-panel" aria-current="false">
                  <span class="no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="t">{project.data.title}</span>
                </button>
              </li>
            );
          })}
        </>
      ))}
    </ul>
  </div>

  <section class="ins-panel" id="ins-panel" aria-label="Selected build">
    <div class="ins-top">
      <div class="ins-ctl">
        <button class="ins-tour glass" data-kind="dark" data-tier="regular" data-pill type="button" aria-pressed="true" aria-label="Pause the project tour"><svg data-i="pause" class="icon" aria-hidden="true"><use href="#i-pause" /></svg><svg data-i="play" class="icon" aria-hidden="true"><use href="#i-play" /></svg></button>
        <button class="ins-prev glass" data-kind="dark" data-tier="regular" data-pill type="button" aria-label="Previous build"><svg class="icon" aria-hidden="true"><use href="#i-chev-l" /></svg></button>
        <button class="ins-next glass" data-kind="dark" data-tier="regular" data-pill type="button" aria-label="Next build"><svg class="icon" aria-hidden="true"><use href="#i-chev-r" /></svg></button>
      </div>
    </div>

    {ordered.map(({ project, group }, i) => {
      const d = project.data;
      const liveLabel = d.liveLabel ?? 'View site';
      return (
        <article class="ins-build" id={d.slug} data-slug={d.slug} aria-labelledby={`${d.slug}-title`}>
          <div class="ins-cover-wrap">
            <button class="ins-cover" type="button" aria-pressed="false" aria-label={`${d.title}: show the phone view`}>
              <Image class="desk" src={d.shots.desktop} alt={`${d.title} on a desktop screen`} widths={[640, 960, 1280, 1600]} sizes="(max-width: 960px) 92vw, 52rem" loading={i === 0 ? 'eager' : 'lazy'} />
              <Image class="phone" src={d.shots.phone} alt={`${d.title} on a phone screen`} widths={[390, 780]} sizes="14rem" loading="lazy" />
              <span class="flip-hint glass" data-kind="dark" data-tier="regular" data-pill aria-hidden="true"><svg class="to-phone"><use href="#i-handset" /></svg><svg class="to-desk"><use href="#i-desk" /></svg></span>
            </button>
          </div>
          <div class="ins-body glass" data-kind="dark" data-tier="thick" data-adapt="card">
            <p class="ins-tags">
              <span class="tag">{tags[group]}</span>
              <span>{d.kind === 'commercial' ? 'Commercial' : 'Personal'}</span>
              <span>{d.year}</span>
            </p>
            <h2 class="ins-title" id={`${d.slug}-title`}>{d.title}</h2>
            <div class="ins-overview">
              {d.blurb && <p class="blurb">{d.blurb}</p>}
              <p class="summary">{d.summary}</p>
            </div>
            <div class="ins-tabs" role="tablist" aria-label={`${d.title} details`}>
              <span class="tab-lens" aria-hidden="true"></span>
              <button type="button" role="tab" id={`${d.slug}-t2`} aria-selected="true" aria-controls={`${d.slug}-p2`}>Stack</button>
              <button type="button" role="tab" id={`${d.slug}-t3`} aria-selected="false" tabindex="-1" aria-controls={`${d.slug}-p3`}>Outcome</button>
            </div>
            <div class="ins-tabpanel" role="tabpanel" id={`${d.slug}-p2`} aria-labelledby={`${d.slug}-t2`}>
              <div class="ins-stack" role="list" aria-label="Stack">
                {d.stack.map((item: string) => <span class="glass" data-kind="dark" data-tier="clear" data-pill role="listitem">{item}</span>)}
              </div>
            </div>
            <div class="ins-tabpanel" role="tabpanel" id={`${d.slug}-p3`} aria-labelledby={`${d.slug}-t3`}>
              {d.outcome && <p class="outcome"><strong>{d.outcome}</strong></p>}
              {d.demoNote && <p class="summary">{d.demoNote}</p>}
            </div>
            <div class="ins-actions">
              {d.liveUrl && (
                <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href={d.liveUrl} target="_blank" rel="noopener" aria-label={`${liveLabel}: ${d.title} (opens in new tab)`}>{liveLabel}<svg class="icon" aria-hidden="true"><use href="#i-ext" /></svg></a>
              )}
              {d.caseStudy && (
                <a class="link" href={`/projects/${d.slug}/`}>Read the case study<svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg></a>
              )}
              <button class="details" type="button" data-project-modal={d.slug}>Project details</button>
            </div>
          </div>
        </article>
      );
    })}
  </section>
</div>

<script>
  import '../scripts/projects.js';
</script>
