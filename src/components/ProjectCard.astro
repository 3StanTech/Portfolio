---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 2 | 3 | 4;
  compact?: boolean;
}

const { project, headingLevel = 3, compact = false } = Astro.props;
const Heading = `h${headingLevel}`;
const d = project.data;
const titleLinkLabel = `${d.title}: view details`;
const visitLabel = d.liveLabel ?? 'View site';
---
<article class:list={[
  'card panel',
  {
    'card-compact': compact,
    'card-bubu': d.slug === 'bubu-workout',
    'card-logo': d.slug === 'herminias',
  },
]} data-reveal>
  <div class="card-media">
    <span class="card-media-fallback" aria-hidden="true">{d.title.slice(0, 1)}</span>
    <Image src={d.cover} alt={d.coverAlt ?? `${d.title} project preview`} widths={[420, 720, 1000]} sizes="(max-width: 860px) 100vw, min(28rem, 40vw)" />
  </div>
  <div class="card-body panel-pad">
    <div class="card-meta">
      <span>{d.kind === 'commercial' ? 'Commercial' : 'Personal'}</span>
      <span>{d.year}</span>
    </div>
    <Heading>
      <button class="card-title-link" type="button" data-project-modal={d.slug} aria-label={titleLinkLabel}>
        {d.title}
      </button>
    </Heading>
    <p>{d.blurb ?? d.summary}</p>
    <div class="card-actions">
      {d.liveUrl && (
        <a
          class="card-visit button secondary"
          href={d.liveUrl}
          target="_blank"
          rel="noopener"
          aria-label={`${visitLabel} — ${d.title} (opens in new tab)`}
        >
          {visitLabel}
          <Icon name="external" />
        </a>
      )}
    </div>
  </div>
</article>
