---
// Contact buttons as glass pills (glass overhaul): Email me is glass like the rest and
// every button turns amber on hover (g4.css). Icons come from the sprite (Sprite.astro).
import { contact, mailto } from '../data/contact';

const {
  label = 'Email me',
  subject = contact.defaultSubject,
  showPhone = false,
  showResume = false,
  showGithub = false,
  class: className = '',
  style
} = Astro.props;

const { resumeHref } = contact;
---
<div class:list={['cta-row', className]} style={style}>
  <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href={mailto(subject)}><svg class="icon" aria-hidden="true"><use href="#i-mail" /></svg>{label}</a>
  {showPhone && (
    <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href={contact.phoneHref}><svg class="icon" aria-hidden="true"><use href="#i-phone" /></svg>Call · {contact.phoneDisplay}</a>
  )}
  {showResume && (
    <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href={resumeHref} target="_blank" rel="noopener" aria-label="View Résumé (PDF, opens in new tab)"><svg class="icon" aria-hidden="true"><use href="#i-doc" /></svg>View Résumé</a>
  )}
  {showGithub && (
    <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href={contact.github} target="_blank" rel="noopener" aria-label="View GitHub (opens in new tab)"><svg class="icon" aria-hidden="true"><use href="#i-gh" /></svg>View GitHub</a>
  )}
  <slot />
</div>
