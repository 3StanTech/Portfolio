---
import Icon from './Icon.astro';
import { contact, mailto } from '../data/contact';

const {
  label = 'Email me',
  subject = contact.defaultSubject,
  showPhone = false,
  showResume = false,
  showGithub = false,
  class: className = ''
} = Astro.props;

const resumeHref = '/Tristan_Dolfo_Resume.pdf';
const githubHref = 'https://github.com/3StanTech';
---
<div class:list={['button-row', className]}>
  <a class="button" href={mailto(subject)}>
    <Icon name="mail" />
    {label}
  </a>
  {showPhone && (
    <a class="button secondary" href={contact.phoneHref}>
      <Icon name="phone" />
      Call · {contact.phoneDisplay}
    </a>
  )}
  {showResume && (
    <a class="button tertiary cta-resume" href={resumeHref} target="_blank" rel="noopener" aria-label="View Résumé (PDF, opens in new tab)">
      <Icon name="document" />
      View Résumé
    </a>
  )}
  {showGithub && (
    <a class="button tertiary cta-github" href={githubHref} target="_blank" rel="noopener" aria-label="View GitHub (opens in new tab)">
      <Icon name="github" />
      View GitHub
    </a>
  )}
</div>
<p class="cta-address">Or write to <a href={mailto(subject)}>{contact.email}</a></p>
