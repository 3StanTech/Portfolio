---
import Icon from './Icon.astro';

const {
  label = 'Email me',
  subject = 'Portfolio inquiry',
  showPhone = false,
  showResume = false,
  showGithub = false,
  class: className = ''
} = Astro.props;

const email = 'tristandolfo@gmail.com';
const phone = '0999-882-7004';
// Gmail compose URL opens a pre-filled draft in the browser — reliable even
// when the device has no default mail app registered for mailto:.
const compose = `https://mail.google.com/mail/?view=cm&fs=1&to=${email}&su=${encodeURIComponent(subject)}`;
const resumeHref = '/Tristan_Dolfo_Resume.pdf';
const githubHref = 'https://github.com/3StanTech';
---
<div class:list={['button-row', className]}>
  <a class="button" href={compose} target="_blank" rel="noopener">
    <Icon name="mail" />
    {label}
  </a>
  {showPhone && (
    <a class="button secondary" href="tel:+639998827004">
      <Icon name="phone" />
      Call · {phone}
    </a>
  )}
  {showResume && (
    <a class="button tertiary cta-resume" href={resumeHref} target="_blank" rel="noopener">
      <Icon name="document" />
      View Resume
    </a>
  )}
  {showGithub && (
    <a class="button tertiary cta-github" href={githubHref} target="_blank" rel="noopener">
      <Icon name="github" />
      View Github
    </a>
  )}
</div>
