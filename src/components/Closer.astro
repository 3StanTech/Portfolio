---
// Shared closer (every page but 404): an optional amber kicker, the title from the
// default slot (the marked word uses <span class="accent">), an optional `lead` slot
// before the buttons, glass Email me + Call, and an optional note. data-horizon="out"
// puts the black hole's outgoing rim above it (galaxy.js). Styles live in g4.css.
import CTA from './CTA.astro';

interface Props {
  kicker?: string;
  note?: string;
}

const { kicker, note } = Astro.props as Props;
---
<section class="closer" data-horizon="out" aria-labelledby="closer-title">
  <span class="horizon" aria-hidden="true"></span>
  <div class="container inner" data-reveal>
    {kicker && <p class="kick">{kicker}</p>}
    <h2 class="h2" id="closer-title"><slot /></h2>
    <slot name="lead" />
    <CTA class="center" showPhone />
    {note && <p class="note">{note}</p>}
  </div>
</section>
