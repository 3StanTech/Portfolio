---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Closer from '../components/Closer.astro';
import Constellation from '../components/Constellation.astro';
import Icon from '../components/Icon.astro';
import profilePhoto from '../assets/tristan-profile-centered.png';
import { contact } from '../data/contact';

const principles = [
  {
    title: 'Clear offer',
    body: 'The page should explain what the business does, who it helps, and what visitors should do next without wasting time.',
    projectName: "Herminia's Food",
    evidenceHref: 'https://herminias-food.vercel.app/',
  },
  {
    title: 'Fast, portable build',
    body: 'Lean HTML, CSS, JavaScript, and Astro keep the site quick on mobile and easy to move between practical hosting options.',
    projectName: 'Justdiz Preproductions',
    evidenceHref: 'https://justdiz-preproductions.vercel.app/',
  },
  {
    title: 'Room to grow',
    body: 'The first version stays focused, with enough structure to grow into richer content or a custom system when the business needs it.',
    projectName: 'Omni-Reviewer',
    evidenceHref: 'https://omni-reviewer-demo.web.app/',
  },
];

const stackGroups = [
  { label: 'Languages', items: ['Python', 'JavaScript', 'TypeScript', 'HTML', 'CSS', 'SQL'] },
  { label: 'Frontend', items: ['React', 'Next.js', 'Astro', 'Tailwind CSS'] },
  { label: 'Backend', items: ['Django', 'FastAPI', 'Node.js', 'n8n', 'Supabase', 'Neon', 'Drizzle ORM', 'Auth.js'] },
  { label: 'Agentic Tools', items: ['Claude Code', 'OpenAI Codex', 'Grok Build', 'Ollama', 'OpenRouter'] },
  { label: 'Embedded', items: ['ESP32', 'Arduino', 'Raspberry Pi', 'C++'] },
];

const values = [
  'Verify before validating.',
  'Form and function, neither sacrificed.',
  'Your problem is my problem.',
  'Design is better built together.',
  'Good design leaves room to grow.',
  'Learn, refine, repeat.',
];
---
<Base title="About | Tristan Dolfo" description="About Tristan Dolfo, a full-stack developer building reliable websites and business systems for small teams worldwide." canonical="/about/">
  <section class="section band-mist about-opening">
    <div class="container about-masthead">
      <div class="about-monogram about-monogram-photo" data-reveal>
        <Image
          src={profilePhoto}
          alt="Portrait of Tristan Dolfo, smiling, in a navy coat and grey scarf"
          width={1122}
          height={1402}
          widths={[280, 560, 840]}
          sizes="(max-width: 860px) min(240px, calc(100vw - 1.25rem)), 280px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="about-intro" data-reveal>
        <header class="page-head">
          <p class="page-kicker"><span class="hero-dot" aria-hidden="true"></span>Metro Manila, Philippines</p>
          <h1 class="page-title">A practical partner for <span class="hero-mark">your</span> business.</h1>
        </header>
        <div class="about-bio">
          <p class="about-lede">I’m Tristan, a full-stack developer from the Philippines. I build polished, reliable websites and business systems for small teams worldwide.</p>
          <CTA showPhone class="about-cta" />
        </div>
      </div>
    </div>
    <div class="container about-masthead-divider" aria-hidden="true"></div>
    <div class="container about-profile-notes" data-reveal>
      <blockquote>You run the business. I keep its site and systems working for it.</blockquote>
      <dl class="about-facts">
        <div><dt>Based in</dt><dd>Metro Manila, Philippines</dd></div>
        <div>
          <dt>GitHub</dt>
          <dd>
            <a href={contact.github} target="_blank" rel="noopener" aria-label="3StanTech on GitHub (opens in new tab)">
              <Icon name="github" />
              3StanTech
            </a>
          </dd>
        </div>
        <div>
          <dt>Résumé</dt>
          <dd>
            <a href="/Tristan_Dolfo_Resume.pdf" target="_blank" rel="noopener" aria-label="View Résumé (PDF, opens in new tab)">
              <Icon name="document" />
              View Résumé
            </a>
          </dd>
        </div>
      </dl>
    </div>
    <div class="container about-values" data-reveal>
      <h2 class="about-values-label">My design principles</h2>
      <ul class="about-values-list">
        {values.map((value) => <li>{value}</li>)}
      </ul>
    </div>
  </section>

  <section class="section starfield">
    <Constellation density={95} islandLimit={2} />
    <div class="container">
      <header class="sec-head-bold" data-reveal>
        <h2>What I build with:</h2>
      </header>
      <div class="text-scrim text-scrim-flush" data-reveal>
        <div class="tech-list">
          {stackGroups.map((group) => (
            <div class="tech-row">
              <h3>{group.label}</h3>
              <ul class="stack" aria-label={`${group.label} tools`}>
                {group.items.map((item) => <li class="pill">{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section band-paper">
    <div class="container">
      <header class="sec-head-bold" data-reveal>
        <h2>How I approach the work.</h2>
      </header>
      <div class="principles-list">
        {principles.map((principle) => (
          <article class="principle" data-reveal>
            <div class="principle-head">
              <h3>{principle.title}</h3>
            </div>
            <div class="principle-detail">
              <p>{principle.body}</p>
              <a class="principle-evidence" href={principle.evidenceHref} target="_blank" rel="noopener" aria-label={`See it in ${principle.projectName} (opens in new tab)`}>
                See it in → {principle.projectName}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Closer kicker="Like how I work?" note="A plain email describing your business is enough. I reply within a day.">Tell me what your business <span class="closer-mark">needs.</span></Closer>
</Base>
