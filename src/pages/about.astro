---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Constellation from '../components/Constellation.astro';
import Icon from '../components/Icon.astro';
import profilePhoto from '../assets/tristan-profile.jpg';

const principles = [
  {
    title: 'Clear offer',
    body: 'The page should explain what the business does, who it helps, and what visitors should do next without wasting time.',
    projectName: "Herminia's Food",
    evidenceHref: 'https://herminias-food.vercel.app/',
  },
  {
    title: 'Fast, portable build',
    body: 'Lean HTML, CSS, JavaScript, and Astro keep the site quick on mobile and easy to move between practical hosting options.',
    projectName: 'Justdiz Preproductions',
    evidenceHref: 'https://justdiz-preproductions.vercel.app/',
  },
  {
    title: 'Room to grow',
    body: 'The first version stays focused, with enough structure to add richer content or a small custom system when the business needs it.',
    projectName: 'The Big Thirty',
    evidenceHref: 'https://bday-public.netlify.app/',
  },
];

const stackGroups = [
  { label: 'Languages', items: ['Python', 'JavaScript', 'TypeScript', 'HTML', 'CSS', 'SQL'] },
  { label: 'Frontend', items: ['React', 'Next.js', 'Astro', 'Tailwind CSS'] },
  { label: 'Backend', items: ['Django', 'FastAPI', 'Node.js', 'n8n', 'Supabase', 'Neon', 'Drizzle ORM', 'Auth.js'] },
  { label: 'Agentic Tools', items: ['Claude Code', 'OpenAI Codex', 'Grok Build', 'Ollama', 'OpenRouter'] },
  { label: 'Embedded', items: ['ESP32', 'Arduino', 'Raspberry Pi', 'C++'] },
];
---
<Base title="About | Tristan" description="About Tristan, a software developer building reliable sites and systems for businesses and specific needs." canonical="/about/">
  <section class="section band-mist">
    <div class="container about-masthead">
      <div class="about-identity">
        <header class="page-head" data-reveal>
          <p class="page-kicker"><span class="hero-dot" aria-hidden="true"></span>Philippines · software developer</p>
          <h1 class="page-title">A practical partner for <span class="hero-mark">small-business</span> sites.</h1>
        </header>
        <div class="about-profile" data-reveal>
          <div class="about-monogram about-monogram-photo">
            <Image
              src={profilePhoto}
              alt="Portrait of Tristan Dolfo, smiling, in a navy coat and grey scarf"
              width={600}
              height={600}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <div class="about-profile-notes">
            <blockquote>Make the offer clear, make the site fast, make the next action obvious.</blockquote>
            <dl class="about-facts">
              <div><dt>Based in</dt><dd>Philippines</dd></div>
              <div>
                <dt>GitHub</dt>
                <dd>
                  <a href="https://github.com/3StanTech" target="_blank" rel="noopener">
                    <Icon name="github" />
                    3StanTech
                  </a>
                </dd>
              </div>
              <div>
                <dt>Resume</dt>
                <dd>
                  <a href="/Tristan_Dolfo_Resume.pdf" target="_blank" rel="noopener">
                    <Icon name="document" />
                    View Resume
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
      <div class="about-intro" data-reveal>
        <div class="about-bio">
          <p class="about-lede">I’m Tristan, a software developer from the Philippines. I build polished and reliable websites and systems for various businesses.</p>
          <p>I research before assuming and stay close to the problem. Form and function stay together. I treat failure as part of the work, I am careful about how digital mediums change meaning, and the work is better when we build it together.</p>
          <CTA showPhone subject="Portfolio inquiry" class="about-cta" />
        </div>
      </div>
    </div>
  </section>

  <section class="section starfield">
    <Constellation density={95} islandLimit={2} />
    <div class="container">
      <header class="sec-head-bold" data-reveal>
        <h2 class="is-accent">What I build with:</h2>
      </header>
      <div class="text-scrim text-scrim-flush" data-reveal>
        <div class="tech-list">
          {stackGroups.map((group) => (
            <div class="tech-row">
              <h3>{group.label}</h3>
              <ul class="stack" aria-label={`${group.label} tools`}>
                {group.items.map((item) => <li class="pill">{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section band-paper">
    <div class="container">
      <header class="sec-head-bold" data-reveal>
        <h2>How I approach the work.</h2>
      </header>
      <div class="principles-list">
        {principles.map((principle) => (
          <article class="principle" data-reveal>
            <div class="principle-head">
              <h3>{principle.title}</h3>
            </div>
            <div class="principle-detail">
              <p>{principle.body}</p>
              <a class="principle-evidence" href={principle.evidenceHref} target="_blank" rel="noopener" aria-label={`See it in ${principle.projectName} (opens in new tab)`}>
                See it in → {principle.projectName}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
