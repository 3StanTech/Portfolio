---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Constellation from '../components/Constellation.astro';
import SectionBand from '../components/SectionBand.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProjectModal from '../components/ProjectModal.astro';
import Icon from '../components/Icon.astro';

type Project = CollectionEntry<'projects'>;

const projects: Project[] = await getCollection('projects');
const projectCount = projects.length;
const allWork = projects
  .sort((a: Project, b: Project) => a.data.displayOrder - b.data.displayOrder);

// Fail fast if site origin is missing — structured-data logo/image must be absolute.
const siteUrl = Astro.site;
if (!siteUrl) {
  throw new Error('Astro.site is undefined — set SITE_URL before building.');
}
// Stable public Responsive Studio mark (compact identity for schema surfaces).
const logoUrl = new URL('/logo.png', siteUrl).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Tristan Dolfo',
    email: 'mailto:tristandolfo@gmail.com',
    telephone: '+639998827004',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'PH'
    },
    jobTitle: 'Full-Stack Developer',
    image: logoUrl
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Tristan Dolfo Web Development',
    areaServed: 'Philippines',
    email: 'mailto:tristandolfo@gmail.com',
    telephone: '+639998827004',
    serviceType: ['Business websites', 'Restaurant websites', 'Static web development', 'Business systems'],
    logo: logoUrl,
    image: logoUrl
  }
];
---
<Base jsonLd={jsonLd}>
  <section class="hero">
    <Constellation class="fade-edge" />
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker"><span class="hero-dot" aria-hidden="true"></span>Philippines · full-stack developer</p>
        <h1 class="hero-title">Sites and systems for your <span class="hero-mark">every</span> need.</h1>
        <p class="hero-sub">I build websites for small businesses and full-stack apps that real people use every day.</p>
        <CTA showPhone showResume showGithub />
        <p class="hero-trust"><span class="hero-trust-count">{projectCount}</span> builds · replies within a day</p>
      </div>
      <aside class="works panel" aria-label="Selected work">
        <a class="work-hire" href="/projects/">
          <span class="work-icon" aria-hidden="true"><Icon name="code" /></span>
          <span class="work-text">
            <strong>Hiring a developer?</strong>
            <span>Case studies, live demos and my résumé</span>
          </span>
          <Icon name="arrow" />
        </a>
        <p class="works-label">Selected work</p>
        <ol class="works-list">
          {allWork.map((project, i) => (
            <li>
              <button
                class="work"
                type="button"
                data-project-modal={project.data.slug}
                aria-label={`${project.data.title} — view details`}
              >
                <span class="work-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="work-text">
                  <strong>{project.data.title}</strong>
                  <span>{project.data.clientType}</span>
                </span>
                <Icon name="arrow" />
              </button>
            </li>
          ))}
        </ol>
        <p class="works-foot">{allWork.length} distinct briefs, each designed around the business or story it serves.</p>
      </aside>
    </div>
  </section>

  <SectionBand tone="sky">
    <header class="sec-head-bold">
      <h2>From the right scope to a successful launch.</h2>
      <p class="sec-lead">I build with your goals in mind, and your vision in hand.</p>
    </header>
    <div class="split scope-process">
      <div class="scope-copy">
        <h3>One-page presence, full business site, or a focused custom build.</h3>
        <p>Each package follows the content, urgency, and customer actions for each client. Every successful deploy stays reliable and easy to maintain.</p>
        <a class="button secondary" href="/services/">See website packages</a>
      </div>
      <ProcessSteps />
    </div>
  </SectionBand>

  <section class="section band-dark closer">
    <Constellation class="fade-edge" />
    <div class="container closer-inner">
      <p class="closer-kicker">Ready when you are!</p>
      <h2 class="closer-title">Tell me what you need for your online <span class="closer-mark"> presence.</span></h2>
      <CTA label="Email me" showPhone />
      <p class="closer-note">No forms, no pressure. A plain email describing your business is enough. I reply within a day.</p>
    </div>
  </section>

  {allWork.map((project) => <ProjectModal project={project} />)}
</Base>
