---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Closer from '../components/Closer.astro';
import { contact } from '../data/contact';
import profilePhoto from '../assets/tristan-profile-centered.png';

type Project = CollectionEntry<'projects'>;

const projects: Project[] = await getCollection('projects');
const projectCount = projects.length;
const allWork = projects
  .sort((a: Project, b: Project) => a.data.displayOrder - b.data.displayOrder);

// Fail fast if site origin is missing — structured-data logo/image must be absolute.
const siteUrl = Astro.site;
if (!siteUrl) {
  throw new Error('Astro.site is undefined: set SITE_URL before building.');
}
// Stable public logo (compact identity for schema surfaces).
const logoUrl = new URL('/logo.png', siteUrl).toString();
// The portrait is the Person image; getImage() gives an optimized, hashed URL.
const portrait = await getImage({ src: profilePhoto, width: 560, format: 'webp' });
const portraitUrl = new URL(portrait.src, siteUrl).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Tristan Dolfo',
    email: `mailto:${contact.email}`,
    telephone: contact.phoneE164,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'PH'
    },
    jobTitle: 'Full-Stack Developer',
    url: siteUrl.toString(),
    image: portraitUrl,
    sameAs: [contact.github, contact.facebook]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Tristan Dolfo Web Development',
    url: siteUrl.toString(),
    areaServed: 'Worldwide',
    email: `mailto:${contact.email}`,
    telephone: contact.phoneE164,
    serviceType: ['Business websites', 'Web applications', 'Business systems', 'Website care plans'],
    logo: logoUrl,
    image: logoUrl
  }
];

// The headline's words, wrapped at build time for the blur-up (fx.css): each word is a
// span with its index; the marked word keeps its accent span inside.
const headline: { text: string; accent?: boolean }[] = [
  { text: 'Sites' }, { text: 'and' }, { text: 'systems' }, { text: 'that' },
  { text: 'work', accent: true }, { text: 'for' }, { text: 'your' }, { text: 'business.' },
];
const steps = [
  { name: 'Scope', text: 'First, I learn what your business needs to succeed: your offer, your audience, your goals. This gives the build direction from day one.' },
  { name: 'Build', text: 'I turn the scope into a secure, responsive site with SEO essentials, structured data, and direct contact routes.' },
  { name: 'Launch', text: 'A focused first version goes live, then I refine it based on how real visitors use it.' },
];
---
<Base jsonLd={jsonLd}>
  <section class="hero" data-horizon="in" aria-labelledby="hero-title">
    <div class="container hero-inner" data-words-box>
      <p class="mono kicker" style="--fx-d: 0ms">Philippines · full-stack developer</p>
      <h1 class="h1" id="hero-title" data-words>{headline.map((word, i) => (
        <><span class="w" style={`--i: ${i}`}>{word.accent ? <span class="accent">{word.text}</span> : word.text}</span>{i < headline.length - 1 && ' '}</>
      ))}</h1>
      <p class="sub" style="--fx-d: 260ms">I build websites for small businesses and <span class="nw">full-stack</span> apps</p>
      <CTA class="center" showPhone showResume showGithub style="--fx-d: 350ms" />
      <p class="trust" style="--fx-d: 440ms"><b>{projectCount}</b> builds · replies within a day</p>
    </div>
    <span class="horizon" aria-hidden="true"></span>
  </section>

  <section class="works" aria-labelledby="works-title">
    <div class="container works-head">
      <h2 id="works-title">selected work</h2>
      <a class="hire glass" data-kind="dark" data-tier="clear" href="/projects/"><span class="hire-ico" aria-hidden="true"><svg><use href="#i-code" /></svg></span><span class="hire-t"><strong>Hiring a developer?</strong><span>here's what i could do</span></span><svg class="hire-go" aria-hidden="true"><use href="#i-arrow" /></svg></a>
      <div class="paddles">
        <button class="paddle glass" data-kind="dark" data-tier="clear" data-pill type="button" data-dir="-1" aria-label="Previous build" aria-controls="rail"><svg aria-hidden="true"><use href="#i-chev-l" /></svg></button>
        <button class="paddle glass" data-kind="dark" data-tier="clear" data-pill type="button" data-dir="1" aria-label="Next build" aria-controls="rail"><svg aria-hidden="true"><use href="#i-chev-r" /></svg></button>
      </div>
    </div>
    <ul class="rail" id="rail" role="list" data-rail>
      {allWork.map((project, i) => (
        <li>
          <a class="tile glass" data-kind="dark" data-tier="regular" href={`/projects/#${project.data.slug}`}>
            <Image src={project.data.shots.desktop} alt="" widths={[344, 688]} sizes="324px" loading={i < 3 ? 'eager' : 'lazy'} />
            <span class="cap"><strong>{project.data.title}</strong><span class="c">{project.data.clientType}</span></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="container rail-foot"><button class="rail-tour glass" data-kind="dark" data-tier="clear" data-pill type="button" aria-pressed="true" aria-label="Pause the project tour" aria-controls="rail"><svg class="i-pause" aria-hidden="true"><use href="#i-pause" /></svg><svg class="i-play" aria-hidden="true"><use href="#i-play" /></svg></button></div>
  </section>

  <section class="band" aria-labelledby="scope-title">
    <span class="pool steel" style="--x: 22%; --y: 62%; --s: 820px" aria-hidden="true"></span>
    <span class="pool amber" style="--x: 82%; --y: 72%; --s: 560px; --d: 22s" aria-hidden="true"></span>
    <div class="container">
      <header class="band-head" data-reveal><h2 class="h2" id="scope-title">From the right scope to a successful launch.</h2><p class="lead">I build with your goals in mind, and your vision in hand.</p></header>
      <div class="bento">
        <div class="wide glass" data-kind="dark" data-tier="regular" data-reveal>
          <h3>One-page presence, full business site, or a focused custom build.</h3>
          <div>
            <p>Each package is shaped by your content, your timeline and the one action you want customers to take. Every build is made to stay reliable and easy to maintain.</p>
            <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href="/services/">See website packages<svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg></a>
          </div>
        </div>
        <div class="prail glass" data-kind="dark" data-tier="regular" data-reveal>
          <ol role="list">
            {steps.map((step, i) => (
              <li style={`--i: ${i}`}>
                <h3>{step.name}</h3>
                <span class="pnode" aria-hidden="true"></span>
                {i < steps.length - 1 && <span class="pline" aria-hidden="true"></span>}
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <Closer kicker="Ready when you are." note="No forms, no pressure. A plain email describing your business is enough. I reply within a day.">Tell me what you need for your online <span class="accent">presence.</span></Closer>
</Base>

<script>
  import '../scripts/home.js';
</script>
