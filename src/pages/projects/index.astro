---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Closer from '../../components/Closer.astro';
import Constellation from '../../components/Constellation.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectModal from '../../components/ProjectModal.astro';

type Project = CollectionEntry<'projects'>;
type Group = Project['data']['group'];

const projects: Project[] = (await getCollection('projects'))
  .sort((a: Project, b: Project) => a.data.displayOrder - b.data.displayOrder);

// Band order and copy. Each band lists its projects by displayOrder.
const bands: { group: Group; id: string; title: string; lead: string }[] = [
  {
    group: 'systems',
    id: 'systems',
    title: 'Apps and systems',
    lead: 'Full-stack builds with sign-in, private data and real business rules.',
  },
  {
    group: 'websites',
    id: 'websites',
    title: 'Business websites',
    lead: 'Concept sites for real businesses, ahead of their final launch.',
  },
  {
    group: 'small',
    id: 'small-builds',
    title: 'Personal Projects & Commissions',
    lead: 'Personal sites with a story.',
  },
];
const groupedBands = bands
  .map((band) => ({ ...band, projects: projects.filter((project) => project.data.group === band.group) }))
  .filter((band) => band.projects.length > 0);
---
<Base title="Projects | Tristan Dolfo" description="Projects by Tristan: full-stack apps and systems, business websites, and personal projects and commissions. Check them out, then try for yourself." canonical="/projects/">
  <section class="section starfield">
    <Constellation density={200} islandLimit={4} class="fade-edge" />
    <div class="container">
      <header class="page-head" data-reveal>
        <p class="page-kicker"><span class="hero-dot" aria-hidden="true"></span>{projects.length} builds</p>
        <h1 class="page-title">Built for the people who use them.</h1>
        <p class="page-lead">Check them out, then try for yourself.</p>
      </header>
    </div>
  </section>

  {groupedBands.map((band, i) => (
    <section
      class:list={['section', i % 2 === 0 ? 'band-paper' : 'starfield']}
      id={band.id}
      aria-labelledby={`${band.id}-title`}
    >
      {i % 2 === 1 && <Constellation density={120} islandLimit={2} class="fade-edge" />}
      <div class="container">
        <header class="commissions-head band-head" data-reveal>
          <h2 id={`${band.id}-title`}>{band.title}</h2>
          <p>{band.lead}</p>
        </header>
        <div class="commission-list">
          {band.projects.map((project) => <ProjectCard project={project} compact headingLevel={3} />)}
        </div>
      </div>
    </section>
  ))}

  <Closer kicker="Seen enough?">Tell me which one is <span class="closer-mark">closest</span> to your business.</Closer>

  {groupedBands.map((band) => band.projects.map((project) => <ProjectModal project={project} />))}
</Base>
