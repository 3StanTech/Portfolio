---
import Base from '../layouts/Base.astro';
import Closer from '../components/Closer.astro';
import { mailto } from '../data/contact';

const tiers = [
  {
    tag: 'Starter',
    title: 'A polished one-page presence',
    bestFor: 'owners who mainly need customers to find them and choose them.',
    subject: 'Starter website quote',
    ctaLabel: 'Get a Starter quote',
    points: [
      'Hero, offer, proof, location and contact, one clear CTA',
      'Responsive design for phones and desktops',
      'SEO basics and social preview metadata',
      'Fast static deployment',
    ],
  },
  {
    tag: 'Business',
    title: 'Your full menu or service story, on-site',
    bestFor: 'clients with real content to show, such as a menu, services, or a gallery.',
    subject: 'Business website quote',
    ctaLabel: 'Get a Business quote',
    points: [
      'Multi-section or multi-page site',
      'Menu or services, gallery, reviews, FAQs',
      'Local-business structured data',
      'Clear ordering, booking, or inquiry routes',
    ],
  },
  {
    tag: 'Premier',
    title: 'Custom builds for specific workflows',
    bestFor: 'businesses that need an interactive tool or system, not just an online brochure.',
    subject: 'Premier website quote',
    ctaLabel: 'Get a Premier quote',
    points: [
      'Interactive tools or richer content systems',
      'Serverless functions when the site needs state',
      'Custom performance and accessibility passes',
      'Launch support and post-launch iteration',
    ],
  },
];

---
<Base title="Services | Tristan Dolfo" description="Website packages for small businesses worldwide, shown by outcome and scope without public pricing." canonical="/services/">
  <header class="p-head">
    <div class="container inner" data-reveal>
      <p class="mono kicker">Website packages</p>
      <h1 class="h1">Choose the <span class="accent">shape</span> of the site.</h1>
      <p class="lead">Every build targets one clear customer action, ships fast, and comes with an optional care plan after launch. The right scope depends on your content and how much the site needs to do for you.</p>
    </div>
  </header>

  <section class="pg-sec" aria-label="Website tiers">
    <div class="container">
      <div class="svc-tiers">
        {tiers.map((tier) => {
          const recommended = tier.tag === 'Business';
          return (
            <article class:list={['svc-tier glass', { 'is-recommended': recommended }]} data-kind="dark" data-tier={recommended ? 'thick' : 'regular'} data-reveal>
              <div class="svc-labels">
                <span class="mono svc-tag">{tier.tag}</span>
                {recommended && <span class="badge">Most owners start here</span>}
              </div>
              <h2>{tier.title}</h2>
              <p class="svc-fit"><strong>Best for:</strong> {tier.bestFor}</p>
              <ul class="dia">
                {tier.points.map((point) => <li>{point}</li>)}
              </ul>
              <a class="btn glass" data-kind="dark" data-tier="clear" data-pill href={mailto(tier.subject)}>
                {tier.ctaLabel}
                <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
              </a>
            </article>
          );
        })}
      </div>
      <div class="svc-includes" data-reveal>
        <p class="mono">Every tier includes</p>
        <ul class="stack" aria-label="Included with every website tier">
          <li class="pill">SEO basics</li>
          <li class="pill">Structured data</li>
          <li class="pill">Fast static deployment</li>
        </ul>
        <p class="svc-plus">+ Optional care and growth plans after launch</p>
      </div>
    </div>
  </section>

  <Closer kicker="After launch">
    Keep your site <span class="accent">maintained.</span>
    <p class="lead" slot="lead">Optional care plans cover updates, small fixes, SEO improvements and growth work, scoped once the first version is live.</p>
  </Closer>
</Base>
